{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "totui hook session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "totui hook stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "totui hook session-end"
          }
        ]
      }
    ]
  }
}
